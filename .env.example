# ===== 应用 =====
# development | test | production
APP_ENV=development
PORT=3200
# 前端可访问来源（生产为正式域名）
APP_ORIGIN=http://localhost:5373
ORG_TIMEZONE=Asia/Shanghai
# 演示登录开关：APP_ENV=production 时若为 true，服务启动将直接失败
DEMO_LOGIN_ENABLED=false

# ===== 数据库 =====
DATABASE_URL=postgres://review360:review360_dev@localhost:56432/review360

# ===== 会话 =====
# 生产必须替换为强随机值；禁止将真实值写入任何文件
SESSION_SECRET=change-me-to-a-long-random-secret

# ===== 对象存储（M3 月报文件启用，开发期可指向本地 MinIO） =====
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ===== 飞书（M6 启用；未配置时使用测试适配器，仅记录不真实送达） =====
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=

# Stage 1: approved Feishu identities must belong to this explicitly configured organization.
# Required with FEISHU_APP_ID/SECRET; never inferred from the first database organization.
FEISHU_ORG_ID=
FEISHU_TENANT_KEY=
# Integration tests DO NOT use DATABASE_URL or load the business .env.
# Configure these in a dedicated test terminal only after approving its local server/port:
# APP_ENV=test
# TEST_DB_ISOLATED=true
# TEST_DATABASE_URL=postgres://TEST_USER:TEST_PASSWORD@127.0.0.1:TEST_PORT/review360_test_UNIQUE_RUN_ID
# To create a NEW disposable database via test:isolated (never an existing business DB):
# TEST_DATABASE_ADMIN_URL=postgres://TEST_USER:TEST_PASSWORD@127.0.0.1:TEST_PORT/postgres
# TEST_DB_CREATE=CONFIRMED_LOCAL_DISPOSABLE

# Optional qualitative growth analysis. Empty configuration disables generation honestly.
# Base URL includes the provider's /v1 path; the service appends /chat/completions.
GROWTH_AI_BASE_URL=
GROWTH_AI_MODEL=
GROWTH_AI_API_KEY=
# Isolated compose uses DUAL_GROWTH_AI_BASE_URL / DUAL_GROWTH_AI_MODEL / DUAL_GROWTH_AI_API_KEY.

# Docker Compose overrides. Generate independent random values for these secrets.
DOCKER_SESSION_SECRET=
INITIAL_SETUP_TOKEN=
INITIAL_ORG_NAME=
INITIAL_ADMIN_NAME=
# DOCKER_APP_ORIGIN=http://localhost:5373
# DOCKER_APP_ENV=development
