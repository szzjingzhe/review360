# 前端镜像：构建静态产物后交给 nginx 托管，并把 /api 反代到 api 服务。
FROM node:22-alpine AS build

WORKDIR /app
# 非交互构建下 corepack 会因下载确认提示而卡住，必须显式关闭
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable

# 同 Dockerfile：先拷清单以复用依赖层
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY apps/worker/package.json apps/worker/
COPY packages/domain/package.json packages/domain/
COPY packages/database/package.json packages/database/

RUN pnpm install --frozen-lockfile

COPY apps/web apps/web
COPY packages/domain/src/item-reasons.ts packages/domain/src/item-reasons.ts
COPY packages/domain/src/appeal-classification.ts packages/domain/src/appeal-classification.ts

# 前端仅连接真实后端。
RUN pnpm --filter @360/web build

FROM nginx:1.27-alpine
COPY infra/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/web/dist /usr/share/nginx/html
EXPOSE 80
